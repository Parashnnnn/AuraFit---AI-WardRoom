{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "User account profile and styling preferences",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "name": { "type": "string" },
        "email": { "type": "string" },
        "photoURL": { "type": "string" },
        "username": { "type": "string" },
        "gender": { "type": "string" },
        "height": { "type": "string" },
        "clothingSize": { "type": "string" },
        "preferredFit": { "type": "string" },
        "preferredStyles": { "type": "array" },
        "favoriteColors": { "type": "array" },
        "colorsToAvoid": { "type": "array" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["uid", "name", "email"]
    },
    "WardrobeItem": {
      "title": "WardrobeItem",
      "description": "An individual piece of clothing in the user's wardrobe",
      "type": "object",
      "properties": {
        "image": { "type": "string" },
        "category": { "type": "string" },
        "color": { "type": "string" },
        "pattern": { "type": "string" },
        "style": { "type": "string" },
        "size": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["category", "color", "image", "createdAt"]
    },
    "Outfit": {
      "title": "Outfit",
      "description": "Generated or saved outfit recommendation",
      "type": "object",
      "properties": {
        "occasion": { "type": "string" },
        "style": { "type": "string" },
        "mood": { "type": "string" },
        "itemsUsed": { "type": "array" },
        "generatedResult": { "type": "object" },
        "createdAt": { "type": "string" }
      },
      "required": ["occasion", "style", "createdAt"]
    },
    "UserPreferences": {
      "title": "UserPreferences",
      "description": "Personalized styling and app theme settings",
      "type": "object",
      "properties": {
        "theme": { "type": "string" },
        "stylePreferences": { "type": "object" },
        "updatedAt": { "type": "string" }
      }
    }
  },
  "firestore": {
    "/users/{uid}": {
      "schema": "UserProfile",
      "description": "Top-level user profile"
    },
    "/users/{uid}/wardrobe/{itemId}": {
      "schema": "WardrobeItem",
      "description": "User's digital closet clothing items"
    },
    "/users/{uid}/outfits/{outfitId}": {
      "schema": "Outfit",
      "description": "Outfits generated by AI stylist"
    },
    "/users/{uid}/savedOutfits/{outfitId}": {
      "schema": "Outfit",
      "description": "User saved favorite looks"
    },
    "/users/{uid}/preferences/settings": {
      "schema": "UserPreferences",
      "description": "User theme and personalized styling settings"
    }
  }
}
